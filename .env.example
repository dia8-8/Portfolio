# Copy to .env.local for local dev. On Vercel: Project Settings -> Environment Variables.
# NEVER commit the real key. Without a key the site still works: agents fall back to the local rule-based mode.
ANTHROPIC_API_KEY=

# Optional. Default is claude-opus-5-5. For a cheaper public chat use claude-haiku-5-5 or claude-sonnet-5-5.
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optional rate limits per visitor IP (defaults shown)
# AGENT_CHAT_LIMIT=20   # chat requests per 10 minutes
# AGENT_FIT_LIMIT=6     # fit-check requests per 10 minutes
